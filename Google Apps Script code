const SENSOR_SHEET = "Sheet1";
const FORECAST_SHEET = "Forecasts";

const ALPHA_TEMP = 0.02;
const ALPHA_HUM = 0.02;

const START_DATE = new Date("2026-11-13T23:40:42+08:00");

const FORECAST_HOURS = 24;

// ==========================================
// RECEIVE DATA FROM ESP32
// ==========================================

function doGet(e) {
  return handleResponse(e);
}

function doPost(e) {
  return handleResponse(e);
}

function handleResponse(e) {

  var lock = LockService.getScriptLock();

  try {

    lock.waitLock(10000);

    var sheet = SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(SENSOR_SHEET);

    var payload;

    if (e.postData && e.postData.contents) {

      payload = JSON.parse(e.postData.contents);

    } else if (e.parameter) {

      payload = e.parameter;

    } else {

      throw new Error("No data received");
    }

    // Validate sensor data
    var temperature = parseFloat(payload.temperature);
    var humidity = parseFloat(payload.humidity);

    if (!Number.isFinite(temperature) ||
        !Number.isFinite(humidity)) {

      throw new Error("Invalid sensor data");
    }

    if (humidity < 0 || humidity > 100) {

      throw new Error("Invalid humidity range");
    }

    var timestamp = new Date();

    // Store historical data
    sheet.appendRow([
      timestamp,
      temperature,
      humidity
    ]);

    // Return JSON response to ESP32
    return ContentService.createTextOutput(
      JSON.stringify({
        status: "success",
        timestamp: timestamp.toString()
      })
    ).setMimeType(ContentService.MimeType.JSON);

  } catch (error) {

    return ContentService.createTextOutput(
      JSON.stringify({
        status: "error",
        message: error.toString()
      })
    ).setMimeType(ContentService.MimeType.JSON);

  } finally {

    if (lock.hasLock()) {
      lock.releaseLock();
    }
  }
}

// ==========================================
// EMA CALCULATION
// ==========================================

function calculateEMA(values, alpha) {

  if (values.length === 0) {

    throw new Error("No valid data available");
  }

  // Initialize EMA using the first reading
  var ema = values[0];

  // Calculate EMA for all selected readings
  for (var i = 1; i < values.length; i++) {

    ema = alpha * values[i] +
          (1 - alpha) * ema;
  }

  return ema;
}

// ==========================================
// GENERATE 24-HOUR FORECAST
// ==========================================

function generateForecasts() {

  var lock = LockService.getScriptLock();

  try {

    lock.waitLock(10000);

    var ss = SpreadsheetApp.getActiveSpreadsheet();

    var sensorSheet = ss.getSheetByName(SENSOR_SHEET);

    var lastRow = sensorSheet.getLastRow();

    if (lastRow < 2) {

      throw new Error("No historical data available");
    }

    // Read columns A, B and C
    var rawData = sensorSheet
      .getRange(2, 1, lastRow - 1, 3)
      .getValues();

    // Filter historical data
    var filteredData = rawData.filter(function(row) {

      return row[0] instanceof Date &&
             row[0] >= START_DATE &&
             typeof row[1] === "number" &&
             typeof row[2] === "number" &&
             Number.isFinite(row[1]) &&
             Number.isFinite(row[2]) &&
             row[2] >= 0 &&
             row[2] <= 100;
    });

    if (filteredData.length < 2) {

      throw new Error("Insufficient historical data");
    }

    // Sort data by timestamp
    filteredData.sort(function(a, b) {

      return a[0] - b[0];
    });

    // Extract temperature and humidity
    var temperatures = filteredData.map(function(row) {

      return row[1];
    });

    var humidities = filteredData.map(function(row) {

      return row[2];
    });

    // Calculate temperature EMA
    var forecastTemp = calculateEMA(
      temperatures,
      ALPHA_TEMP
    );

    // Calculate humidity EMA
    var forecastHum = calculateEMA(
      humidities,
      ALPHA_HUM
    );

    // Get the latest historical timestamp
    var lastTimestamp =
      filteredData[filteredData.length - 1][0];

    // Create Forecasts sheet automatically
    var forecastSheet = ss.getSheetByName(FORECAST_SHEET);

    if (!forecastSheet) {

      forecastSheet = ss.insertSheet(FORECAST_SHEET);
    }

    // Prepare forecast headers
    var headers = [
      "Timestamp",
      "Forecasted Temperature (°C)",
      "Forecasted Humidity (%)",
      "Temperature Upper Bound",
      "Temperature Lower Bound",
      "Humidity Upper Bound",
      "Humidity Lower Bound"
    ];

    var forecastData = [];

    // Generate hourly forecasts for 24 hours
    for (var hour = 1; hour <= FORECAST_HOURS; hour++) {

      var forecastTime = new Date(
        lastTimestamp.getTime() +
        hour * 60 * 60 * 1000
      );

      // Estimated bounds using +/- 10%
      var tempUpper = forecastTemp * 1.10;
      var tempLower = forecastTemp * 0.90;

      var humUpper = Math.min(100, forecastHum * 1.10);
      var humLower = Math.max(0, forecastHum * 0.90);

      forecastData.push([
        forecastTime,
        forecastTemp,
        forecastHum,
        tempUpper,
        tempLower,
        humUpper,
        humLower
      ]);
    }

    // Remove previous forecasts
    forecastSheet.clearContents();

    // Insert headers
    forecastSheet
      .getRange(1, 1, 1, headers.length)
      .setValues([headers]);

    // Insert forecast results
    forecastSheet
      .getRange(2, 1, forecastData.length, headers.length)
      .setValues(forecastData);

    // Format forecast headers
    forecastSheet
      .getRange(1, 1, 1, headers.length)
      .setFontWeight("bold")
      .setBackground("#1F4E78")
      .setFontColor("#FFFFFF");

    // Format timestamp
    forecastSheet
      .getRange(2, 1, forecastData.length, 1)
      .setNumberFormat("dd/MM/yyyy HH:mm:ss");

    // Format numerical values
    forecastSheet
      .getRange(2, 2, forecastData.length, 6)
      .setNumberFormat("0.00");

    forecastSheet.setFrozenRows(1);

    forecastSheet.autoResizeColumns(1, headers.length);

    // Display results in execution log
    Logger.log("Selected Records: " + filteredData.length);

    Logger.log("Temperature Alpha: " + ALPHA_TEMP);

    Logger.log("Humidity Alpha: " + ALPHA_HUM);

    Logger.log("Forecasted Temperature: " + forecastTemp);

    Logger.log("Forecasted Humidity: " + forecastHum);

    ss.toast(
      "24-hour forecast generated successfully",
      "EMA Forecasting",
      5
    );

  } finally {

    if (lock.hasLock()) {
      lock.releaseLock();
    }
  }
}

// ==========================================
// CUSTOM GOOGLE SHEETS MENU
// ==========================================

function onOpen() {

  SpreadsheetApp.getUi()
    .createMenu("EMA Forecasting")
    .addItem("Generate Forecasts", "generateForecasts")
    .addToUi();
}
